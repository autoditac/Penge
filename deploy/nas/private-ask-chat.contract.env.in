# Non-loadable application contract template.
#
# #345 fixes the model and security posture below.  The remaining assignments
# stay unresolved until #344 and #346 publish their exact variable names.

PENGE_CHAT_MODEL=hydrafusion
PENGE_CHAT_DATABASE_URL_FILE=@@DATABASE_URL_SECRET_TARGET@@
PENGE_DB_URL_FILE=@@FINANCE_MCP_DATABASE_URL_SECRET_TARGET@@
PENGE_CHAT_PUBLIC_API_BASE=@@CHAT_PUBLIC_API_BASE_WITH_TRAILING_SLASH@@
PENGE_CHAT_PUBLIC_APP_ORIGIN=@@CHAT_PUBLIC_APP_ORIGIN@@
PENGE_CHAT_GITHUB_CLIENT_ID=@@GITHUB_CLIENT_ID@@
PENGE_CHAT_GITHUB_CLIENT_SECRET_FILE=@@GITHUB_CLIENT_SECRET_TARGET@@
PENGE_CHAT_TOKEN_KEYRING_FILE=@@TOKEN_KEYRING_SECRET_TARGET@@
PENGE_CHAT_IDENTITY_PEPPER_FILE=@@IDENTITY_PEPPER_SECRET_TARGET@@
PENGE_CHAT_PROXY_SHARED_SECRET_FILE=@@PROXY_SECRET_TARGET@@
PENGE_CHAT_TRUSTED_PROXY_ISSUER=@@TRUSTED_PROXY_ISSUER@@
# security-contract: copilot-mode=empty
@@COPILOT_MODE_EMPTY_ENV_ASSIGNMENT@@
# security-contract: model-fallback=false
@@MODEL_FALLBACK_DISABLED_ENV_ASSIGNMENT@@
# security-contract: hydrafusion-entitlement-required=true
@@HYDRAFUSION_ENTITLEMENT_REQUIRED_ENV_ASSIGNMENT@@
# security-contract: source-coverage-required=true
@@SOURCE_COVERAGE_STARTUP_GATE_ENV_ASSIGNMENT@@
# security-contract: mcp-transport=stdio
@@PROCESS_LOCAL_STDIO_MCP_ENV_ASSIGNMENT@@
# security-contract: default-tools-enabled=false
@@DEFAULT_TOOLS_DISABLED_ENV_ASSIGNMENT@@
# security-contract: transcript-persistence=false
@@TRANSCRIPT_PERSISTENCE_DISABLED_ENV_ASSIGNMENT@@
# security-contract: structured-logging=redacted
@@PRIVACY_SAFE_STRUCTURED_LOGGING_ENV_ASSIGNMENT@@
# security-contract: metrics=private
@@PRIVACY_SAFE_METRICS_ENV_ASSIGNMENT@@
