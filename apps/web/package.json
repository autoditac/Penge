{
  "name": "@penge/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Penge WebUI — reporting-first household finance cockpit.",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "dev": "vite --host 127.0.0.1",
    "generate:api": "openapi-typescript ../../docs/api/openapi.json -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@tanstack/react-query": "5.104.5",
    "echarts": "6.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
