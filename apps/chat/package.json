{
  "name": "@penge/chat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Strict multi-user chat backend for the Penge Copilot loop.",
  "main": "dist/index.js",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "lint": "eslint . && prettier --check ."
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.16",
    "@modelcontextprotocol/sdk": "1.30.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
