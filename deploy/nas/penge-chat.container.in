# Non-loadable rootless Quadlet template for the private Ask Penge chat.
#
# This file deliberately retains @@...@@ contract tokens until #343-#346
# publish the exact backend, WebUI, MCP, and architecture contracts.  Its
# .container.in suffix prevents Quadlet from loading it accidentally, and the
# installer refuses to render it while any token remains.

[Unit]
Description=Penge private Ask chat
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.config/penge/private-ask-chat.contract-approved

[Container]
Image=ghcr.io/autoditac/penge/chat@sha256:@@CHAT_IMAGE_DIGEST@@
ContainerName=penge-chat
Network=@@CHAT_ROOTLESS_NETWORK@@
UserNS=keep-id
PublishPort=127.0.0.1:8123:@@CHAT_HTTP_PORT@@
Secret=penge-chat-github-oauth-@@GITHUB_OAUTH_SECRET_VERSION@@,type=mount,target=@@GITHUB_OAUTH_SECRET_TARGET@@,mode=0400,uid=@@CHAT_CONTAINER_UID@@,gid=@@CHAT_CONTAINER_GID@@
Secret=penge-chat-token-keyring-@@TOKEN_KEYRING_SECRET_VERSION@@,type=mount,target=@@TOKEN_KEYRING_SECRET_TARGET@@,mode=0400,uid=@@CHAT_CONTAINER_UID@@,gid=@@CHAT_CONTAINER_GID@@
Secret=penge-chat-database-url-@@DATABASE_URL_SECRET_VERSION@@,type=mount,target=@@DATABASE_URL_SECRET_TARGET@@,mode=0400,uid=@@CHAT_CONTAINER_UID@@,gid=@@CHAT_CONTAINER_GID@@
EnvironmentFile=%h/.config/penge/private-ask-chat.contract.env
Volume=@@MCP_READ_ONLY_SOURCE@@:@@MCP_READ_ONLY_TARGET@@:ro
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
Tmpfs=/tmp:rw,noexec,nosuid,nodev,size=64m
HealthCmd=@@CHAT_HEALTH_COMMAND@@
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=@@CHAT_HEALTH_START_PERIOD@@
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=120
ExecStartPre=/usr/bin/test -r %h/.config/penge/private-ask-chat.contract.env
ExecStartPost=/bin/sh -c 'set -eu; image_id=$(podman inspect penge-chat --format "{{.Image}}"); digest=$(podman image inspect "$image_id" --format "{{.Digest}}"); test -n "$digest"; echo "penge-chat deploy: $(date -Iseconds) digest=$digest"'

[Install]
WantedBy=default.target
